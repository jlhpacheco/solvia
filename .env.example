# Solvia — local configuration template.
#
# Set these as environment variables in the terminal where you run
# the app (see README.md, "Run it locally", Step 3), or use .NET
# user-secrets instead. The app reads environment variables only —
# it never reads a .env file. NEVER commit filled-in secrets.
# Empty value = not set.
#
# These names are bridged to the app's PayPal:/Ollama: config sections
# by src/Solvia/Program.cs. The double-underscore style
# (PayPal__ClientId) works too.

# PayPal sandbox app credentials — from developer.paypal.com, where you
# create a free sandbox app. Sandbox only: no real money, ever.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Local AI model — Microsoft Phi-4-mini served by Ollama on this same
# computer. Student data never leaves the machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini

# College fee data file (real published fees for 25 campuses).
FEES_CSV_PATH=data/fees.csv

# Payment-complete webhook — OPTIONAL. When a permit goes live (paid or
# free), Solvia POSTs one small JSON event to this URL (built for a
# Zapier "Catch Hook" — see docs/zapier-recipe.md). Empty = disabled:
# nothing is sent. The event carries no student PII.
WEBHOOK_URL=
