# Solvia — local configuration template.
#
# Set these as environment variables in the terminal where you run
# the app (see README.md, "Run it locally", Step 3), or use .NET
# user-secrets instead. The app reads environment variables only —
# it never reads a .env file. NEVER commit filled-in secrets.
# Empty value = not set.
#
# These names are bridged to the app's configuration sections
# by src/Solvia/Program.cs. The double-underscore style
# (PayPal__ClientId) works too.

# PayPal sandbox app credentials — from developer.paypal.com, where you
# create a free sandbox app. Sandbox only: no real money, ever.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
<redacted>
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
# PayPal webhook id (from the developer dashboard, once a webhook is
# registered for this app). An identifier, not a credential. Empty
# until registered; the webhook endpoint stays inert without it.
PAYPAL_WEBHOOK_ID=

# AI model — Microsoft Phi-4-mini served by Ollama on the application
# host by default. A remote endpoint receives the extraction inputs.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini
# Total model response budget, including loading: default 10 seconds.
# Slower local runners can opt into 90; values are clamped to 1–90.
OLLAMA_TIMEOUT_SECONDS=10

# Explicit provider selection: ollama (default) or meta (hosted).
# Meta sends vehicle text to Meta. Keep credentials only on the server.
AI_PROVIDER=ollama
META_API_KEY=
# Standard model only; Contributor variants are intentionally rejected.
META_MODEL=muse-spark-1.3
META_TIMEOUT_SECONDS=10

# College fee data file (real published fees for 10 campuses).
FEES_CSV_PATH=data/fees.csv

# Payment-complete webhook — OPTIONAL. When a permit goes live (paid or
# free), Solvia POSTs one small JSON event to this URL (built for a
# Zapier "Catch Hook" — see docs/zapier-recipe.md). Empty = disabled:
# nothing is sent. The event carries no student PII.
WEBHOOK_URL=
