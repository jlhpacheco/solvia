@model Solvia.Models.PermitApplication
@{
    var amount = ViewData["AmountDisplay"] as string;
    var isPaid = Model.PaymentStatus == Solvia.Models.Enums.PaymentStatus.Paid;
    var isFree = Model.PaymentStatus == Solvia.Models.Enums.PaymentStatus.NotRequired;
    var isEmployee = Model.Category == Solvia.Models.Enums.UserCategory.Employee;
    string Date(System.DateOnly d) => d.ToString("MMM d, yyyy");
}

@if (isPaid)
{
    <div class="receipt-card">
        <h1 class="display-5 fw-bold">Permit live &#10003;</h1>
        <p class="fs-4">Your payment is complete and this permit is active.</p>
        <p class="fs-5 text-muted mb-1">Permit number (= receipt number)</p>
        <p class="receipt-number">@Model.ReceiptNumber</p>
        <dl class="fs-4">
            <dt>Permit</dt>
            <dd>@(Model.PermitType?.Name ?? "Parking permit")</dd>
            <dt>College</dt>
            <dd>@Model.Campus</dd>
            <dt>Category</dt>
            <dd>@Model.Category</dd>
            <dt>Valid</dt>
            <dd>@Date(Model.StartDate) → @Date(Model.EndDate)</dd>
            <dt>Amount paid</dt>
            <dd>$@amount (PayPal sandbox)</dd>
            <dt>Paid at (UTC)</dt>
            <dd>@Model.PaidAtUtc</dd>
        </dl>
        <div class="receipt-ids">
            <p class="mb-1">PayPal order ID<br /><code>@Model.PayPalOrderId</code></p>
            <p class="mb-0">PayPal capture ID<br /><code>@Model.PayPalCaptureId</code></p>
        </div>
        @if (Model.VerifyToken is not null)
        {
            <a class="btn btn-primary btn-lg w-100 py-3 fs-4 mt-4" href="/verify?t=@Model.VerifyToken">Check this permit</a>
        }
        <p class="mt-3 mb-0"><a class="fs-5" href="/Permits/My">See all my permits</a></p>
    </div>
}
else if (isFree)
{
    <div class="receipt-card">
        <h1 class="display-5 fw-bold">Permit live &#10003;</h1>
        @if (isEmployee)
        {
            <p class="fs-4">Employee permits are <strong>exempt</strong> — no payment was needed or taken.</p>
        }
        else
        {
            <p class="fs-4">This permit is <strong>free</strong> at your college — no payment was needed.</p>
        }
        <p class="fs-5 text-muted mb-1">Permit number (= receipt number)</p>
        <p class="receipt-number">@Model.ReceiptNumber</p>
        <dl class="fs-4">
            <dt>Permit</dt>
            <dd>@(Model.PermitType?.Name ?? "Parking permit")</dd>
            <dt>College</dt>
            <dd>@Model.Campus</dd>
            <dt>Category</dt>
            <dd>@Model.Category</dd>
            <dt>Valid</dt>
            <dd>@Date(Model.StartDate) → @Date(Model.EndDate)</dd>
        </dl>
        @if (Model.VerifyToken is not null)
        {
            <a class="btn btn-primary btn-lg w-100 py-3 fs-4 mt-4" href="/verify?t=@Model.VerifyToken">Check this permit</a>
        }
        <p class="mt-3 mb-0"><a class="fs-5" href="/Permits/My">See all my permits</a></p>
    </div>
}
else
{
    <div class="receipt-card receipt-card-pending">
        <h1 class="display-5 fw-bold">Not paid yet</h1>
        <p class="fs-4">
            This permit is <strong>not</strong> paid (payment status:
            @Model.PaymentStatus). A permit only goes live when a PayPal
            capture returns COMPLETED.
        </p>
        <dl>
            <dt>Fee</dt><dd>$@amount USD</dd>
            <dt>PayPal order ID</dt><dd class="text-break">@(Model.PayPalOrderId ?? "Not created yet")</dd>
            <dt>PayPal capture ID</dt><dd class="text-break">@(Model.PayPalCaptureId ?? "Not issued yet — payment is not confirmed.")</dd>
        </dl>
        <p><a class="btn btn-primary btn-lg fs-4" href="/Checkout/@Model.Id">Back to checkout</a></p>
    </div>
}
