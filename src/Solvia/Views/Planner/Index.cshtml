@model Solvia.Models.ViewModels.PlannerViewModel
@using System.Globalization
@using Solvia.Models.Enums
@{
    ViewData["Title"] = "Plan your parking";
    string Money(int? cents) => cents is null ? "Not published" : "$" + (cents.Value / 100m).ToString("0.00", CultureInfo.InvariantCulture);
    var orderedDays = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };
}
<link rel="stylesheet" href="~/css/planner.css" asp-append-version="true" />
<div class="sv-planner-heading">
    <span class="sv-eyebrow">A LITTLE PLANNING. A CLEARER CHOICE.</span>
    <h1>Plan your parking.</h1>
    <p class="lead">Day passes or a term permit? See the costs for the days you expect to visit.</p>
    <p>Planning for <strong>@Model.PersonName · @Model.CategoryLabel</strong>. <a href="/">Change demo person</a></p>
</div>
@if (!ViewData.ModelState.IsValid)
{
    <div id="planner-errors" asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1"></div>
}
<form asp-action="Compare" method="post" class="sv-card sv-planner-form">
    <div class="mb-4">
        <label for="Campus" class="form-label fw-bold">Your college</label>
        <select asp-for="Campus" class="form-select" required>
            @foreach (var campus in Model.Campuses) { <option value="@campus">@campus</option> }
        </select>
    </div>
    <div class="sv-planner-reader">
        <label for="ScheduleText" class="form-label fw-bold">Describe your visits <span class="fw-normal">(optional)</span></label>
        <p id="schedule-help" class="text-muted">Example: “Tuesdays and Thursdays for three weeks.” When enabled and available, OpenAI's US-developed GPT-OSS 120B, served through Together AI, reads this sentence; built-in rules provide a labeled fallback. Use fictional plans and leave out personal information.</p>
        <textarea asp-for="ScheduleText" rows="2" maxlength="500" class="form-control" aria-describedby="schedule-help" placeholder="Which weekdays, and for how many weeks?"></textarea>
        <button type="submit" class="btn btn-outline-primary mt-3" formaction="@Url.Action("Read")" formnovalidate>Read my schedule</button>
        @if (Model.ReaderNote is not null)
        {
            <p class="alert alert-info mt-3 mb-0" role="status" data-testid="schedule-reader" data-source="@Model.ReaderSource">@Model.ReaderNote Review the choices below before comparing.</p>
        }
    </div>
    <h2 class="h4 mt-4">Confirm your schedule</h2>
    <div class="sv-planner-fields">
        <div>
            <label for="StartDate" class="form-label">Start of your planning period</label>
            <input asp-for="StartDate" type="date" class="form-control" required />
        </div>
        <div>
            <label for="Weeks" class="form-label">Number of weeks</label>
            <input asp-for="Weeks" type="number" min="1" max="26" inputmode="numeric" class="form-control" required aria-describedby="weeks-help" />
            <span id="weeks-help" class="form-text">1–26 weeks, starting on the date you choose.</span>
        </div>
    </div>
    <fieldset class="mt-3">
        <legend class="h6">Which weekdays will you visit?</legend>
        <div class="sv-planner-days">
            @foreach (var day in orderedDays)
            {
                <label for="day-@day" class="sv-planner-day"><input type="checkbox" name="Weekdays" id="day-@day" value="@day" checked="@Model.Weekdays.Contains(day)" /> @day</label>
            }
        </div>
    </fieldset>
    <fieldset class="mt-4">
        <legend class="h6">Term to compare</legend>
        <div class="sv-planner-days">
            @foreach (var term in Enum.GetValues<TermKind>())
            {
                <label for="plan-term-@term" class="sv-planner-day"><input asp-for="Term" type="radio" id="plan-term-@term" value="@term" /> @term</label>
            }
        </div>
    </fieldset>
    <button type="submit" class="btn btn-primary mt-4 sv-cta">Compare my options</button>
</form>
@if (Model.Result is { IsValid: true } result)
{
    <section class="mt-4" aria-labelledby="comparison-title" data-testid="plan-result">
        <span class="sv-eyebrow">YOUR CONFIRMED PLAN</span>
        <h2 id="comparison-title" tabindex="-1">@result.DayCount visits. Two ways to plan.</h2>
        <p>@result.FirstVisit?.ToString("MMM d, yyyy") – @result.LastVisit?.ToString("MMM d, yyyy") · @result.Campus</p>
        <div class="sv-planner-verdict"><strong>@result.Recommendation</strong><p class="mb-0">@result.Reason</p></div>
        <form asp-action="Continue" method="post">
            <input type="hidden" name="Campus" value="@Model.Campus" />
            <input type="hidden" name="StartDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="Weeks" value="@Model.Weeks" />
            <input type="hidden" name="Term" value="@Model.Term" />
            @foreach (var day in Model.Weekdays) { <input type="hidden" name="Weekdays" value="@day" /> }
            <div class="sv-planner-options">
                <article class="sv-card">
                    <h3 class="h4">Day passes</h3>
                    <p class="sv-plan-price" data-testid="daily-total">@Money(result.DailyTotal)</p>
                    <p>@result.DayCount visits × @Money(result.DayCents) per day</p>
                    <p class="text-muted">Planning total for separate one-day permits. Continue buys only the first planned day; future days need their own permits.</p>
                    @if (result.DayCents is not null)
                    {
                        <button class="btn btn-outline-primary" name="choice" value="Daily">Start with one day pass</button>
                        <p class="form-text mt-2">First day: @result.FirstVisit?.ToString("MMM d") · @Money(result.DayCents)</p>
                    }
                </article>
                <article class="sv-card">
                    <h3 class="h4">One term permit</h3>
                    <p class="sv-plan-price" data-testid="term-total">@Money(result.TermCents)</p>
                    @if (result.TermAvailable)
                    {
                        <p>Covers the planned visits under Solvia's demo date rules.</p>
                        <button class="btn btn-primary" name="choice" value="Term">Choose a term permit</button>
                    }
                    else { <p>This option is unavailable for these dates or its fee is not published.</p> }
                    @if (result.Window is not null) { <p class="form-text mt-2">Demo term window: @result.Window.TermStart.ToString("MMM d") – @result.Window.TermEnd.ToString("MMM d"); permit ends @result.Window.PermitEndDate.ToString("MMM d, yyyy").</p> }
                </article>
            </div>
        </form>
        @if (result.BreakEvenDays is { } days) { <p class="mt-3">A term permit costs no more than @days day passes at these catalog rates, when its dates cover your visits.</p> }
        <details class="sv-card mt-3">
            <summary>Visit dates and price source</summary>
            <p class="mt-3"><strong>Catalog snapshot:</strong> @result.FeeAsOf. Prices are researched CSV data, not a live campus feed.</p>
            <p>@result.FeeSource</p>
            <ul class="sv-visit-dates">@foreach (var date in result.VisitDates) { <li>@date.ToString("ddd, MMM d, yyyy")</li> }</ul>
        </details>
    </section>
}
<p class="text-muted mt-4">This is a Sandbox planning demo. Campus eligibility, holidays and availability need confirmation with the college. This comparison creates no order and reserves no parking. You review your vehicle and exact single-permit total before payment.</p>
@section Scripts {
    <script src="~/js/planner.js" asp-append-version="true" defer></script>
}
