@model Solvia.Models.ViewModels.VehicleEditViewModel
@using System.Text.Json
@using Solvia.Models
@using Solvia.Models.Enums
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@*
    The shared garage form (R2): Create and Edit render THIS partial,
    so the two screens can never drift. Field order is the reference
    app's: Plate → State → Make → Model → Color.

    Make and Model are dropdowns fed by VehicleCatalog. The Model
    list cascades from the chosen Make (the catalog is embedded as
    JSON below and a small script rebuilds the options). Both fields
    end with an "Other — type it" escape that reveals a text box,
    and a stored value that is not in the catalog is re-offered as
    an option — off-catalog values are never dropped.
*@
@{
    var currentMake = Model.Make;
    var makeIsOther = currentMake == VehicleCatalog.OtherMakeValue;
    var makes = new List<string>(VehicleCatalog.Makes);
    if (!string.IsNullOrWhiteSpace(currentMake)
        && !makeIsOther
        && !makes.Contains(currentMake))
    {
        // Re-offer a stored off-catalog make (e.g. "GMC").
        makes.Insert(0, currentMake);
    }

    var currentModel = Model.Model;
    var modelIsOther = currentModel == VehicleCatalog.OtherModelValue;
    var models = new List<string>();
    if (!makeIsOther)
    {
        models.AddRange(VehicleCatalog.ModelsFor(currentMake));
    }

    if (!string.IsNullOrWhiteSpace(currentModel)
        && !modelIsOther
        && !models.Contains(currentModel))
    {
        // Re-offer a stored off-catalog model (e.g. "Sierra 1500").
        models.Insert(0, currentModel);
    }

    var catalogJson = JsonSerializer.Serialize(VehicleCatalog.ModelsByMake);
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger fs-5" role="alert">@Model.Error</div>
}

<div class="mb-4">
    <label asp-for="Plate" class="form-label fs-4 fw-semibold">License plate</label>
    <input asp-for="Plate" class="form-control form-control-lg text-uppercase"
           placeholder="e.g. 8XYZ123" autocomplete="off" maxlength="20" />
    <div class="form-text fs-6">The plate is how the college finds your permit.</div>
</div>

<div class="mb-4">
    <label asp-for="State" class="form-label fs-4 fw-semibold">Plate state</label>
    <select asp-for="State" asp-items="Html.GetEnumSelectList<UsState>()"
            class="form-select form-select-lg"></select>
</div>

<div class="mb-4">
    <label for="vehicleMake" class="form-label fs-4 fw-semibold">Make</label>
    <select id="vehicleMake" name="Make" class="form-select form-select-lg">
        <option value="" selected="@(string.IsNullOrWhiteSpace(currentMake) ? "selected" : null)">— Choose a make —</option>
        @foreach (var make in makes)
        {
            <option value="@make" selected="@(currentMake == make ? "selected" : null)">@make</option>
        }
        <option value="@VehicleCatalog.OtherMakeValue" selected="@(makeIsOther ? "selected" : null)">Other — type it</option>
    </select>
    <div id="vehicleMakeOtherWrap" class="mt-2" style="@(makeIsOther ? "" : "display:none")">
        <input id="vehicleMakeOther" name="MakeOther" value="@Model.MakeOther"
               class="form-control form-control-lg" placeholder="Type the make" autocomplete="off" maxlength="50" />
    </div>
</div>

<div class="mb-4">
    <label for="vehicleModel" class="form-label fs-4 fw-semibold">Model</label>
    <select id="vehicleModel" name="Model" class="form-select form-select-lg">
        <option value="" selected="@(string.IsNullOrWhiteSpace(currentModel) ? "selected" : null)">— Choose a model —</option>
        @foreach (var modelName in models)
        {
            <option value="@modelName" selected="@(currentModel == modelName ? "selected" : null)">@modelName</option>
        }
        <option value="@VehicleCatalog.OtherModelValue" selected="@(modelIsOther ? "selected" : null)">Other — type it</option>
    </select>
    <div id="vehicleModelOtherWrap" class="mt-2" style="@(modelIsOther ? "" : "display:none")">
        <input id="vehicleModelOther" name="ModelOther" value="@Model.ModelOther"
               class="form-control form-control-lg" placeholder="Type the model" autocomplete="off" maxlength="50" />
    </div>
</div>

<div class="mb-2">
    <label asp-for="Color" class="form-label fs-4 fw-semibold">Color</label>
    <select asp-for="Color" asp-items="Html.GetEnumSelectList<VehicleColor>()"
            class="form-select form-select-lg"></select>
</div>

<script type="application/json" id="sv-vehicle-catalog">@Html.Raw(catalogJson)</script>
<script>
    (function () {
        var OTHER_MAKE = "@VehicleCatalog.OtherMakeValue";
        var OTHER_MODEL = "@VehicleCatalog.OtherModelValue";
        var catalogEl = document.getElementById('sv-vehicle-catalog');
        var makeSel = document.getElementById('vehicleMake');
        var modelSel = document.getElementById('vehicleModel');
        if (!catalogEl || !makeSel || !modelSel) { return; }
        var catalog = JSON.parse(catalogEl.textContent);
        var makeOtherWrap = document.getElementById('vehicleMakeOtherWrap');
        var modelOtherWrap = document.getElementById('vehicleModelOtherWrap');

        function syncMakeOther() {
            makeOtherWrap.style.display = makeSel.value === OTHER_MAKE ? '' : 'none';
        }

        function syncModelOther() {
            modelOtherWrap.style.display = modelSel.value === OTHER_MODEL ? '' : 'none';
        }

        function addOption(select, value, label) {
            var opt = document.createElement('option');
            opt.value = value;
            opt.textContent = label;
            select.appendChild(opt);
            return opt;
        }

        // The cascade: rebuild the Model list from the chosen Make.
        // Whatever model was picked before is kept when it still
        // fits, and re-offered when it does not — a make change
        // never silently throws a typed value away.
        function rebuildModels() {
            var previous = modelSel.value;
            var models = catalog[makeSel.value] || [];
            modelSel.innerHTML = '';
            addOption(modelSel, '', '— Choose a model —');
            models.forEach(function (m) { addOption(modelSel, m, m); });
            var otherOpt = addOption(modelSel, OTHER_MODEL, 'Other — type it');
            if (previous === OTHER_MODEL) {
                otherOpt.selected = true;
            } else if (previous && models.indexOf(previous) === -1) {
                addOption(modelSel, previous, previous).selected = true;
            } else if (previous) {
                modelSel.value = previous;
            }
            syncModelOther();
        }

        makeSel.addEventListener('change', function () {
            syncMakeOther();
            rebuildModels();
        });
        modelSel.addEventListener('change', syncModelOther);
        syncMakeOther();
        syncModelOther();
    })();
</script>
