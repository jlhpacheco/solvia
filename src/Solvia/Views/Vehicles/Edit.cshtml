@model Solvia.Models.ViewModels.VehicleEditViewModel
@{
    ViewData["Title"] = "Edit vehicle";
}

<h1 class="mt-4">Edit vehicle</h1>
<p class="fs-5">
    Fix anything that changed — the plate is the only field you must keep filled.
</p>

<div class="sv-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <partial name="_VehicleFields" model="Model" />
        <button type="submit" class="btn btn-primary sv-cta w-100 mt-3">Save vehicle</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-lg w-100 mt-2 py-3">Cancel</a>
    </form>
</div>
