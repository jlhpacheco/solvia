@model Solvia.Models.ViewModels.VehicleEditViewModel
@{
    ViewData["Title"] = "Fix my car";
}

<h1 class="display-5 fw-bold">Fix my car</h1>

<form method="post" action="/Vehicles/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />
    <partial name="_VehicleFields" model="Model" />

    <button type="submit" class="btn btn-success btn-lg w-100 py-3 fs-3">Save</button>
</form>
