@model Solvia.Models.ViewModels.VehicleEditViewModel
@{
    ViewData["Title"] = "Add a vehicle";
}

<h1 class="mt-4">Add a vehicle</h1>
<p class="fs-5">
    The permit points at a saved car, so the car comes first.
    Five short fields — the plate is the only one you must fill.
</p>

<div class="sv-card">
    <form asp-action="Create" method="post">
        <input asp-for="ReturnUrl" type="hidden" />
        <partial name="_VehicleFields" model="Model" />
        <button type="submit" class="btn btn-primary sv-cta w-100 mt-3">Save vehicle</button>
        <a href="@(Url.IsLocalUrl(Model.ReturnUrl) ? Model.ReturnUrl : Url.Action("Index"))" class="btn btn-outline-secondary btn-lg w-100 mt-2 py-3">Cancel</a>
    </form>
</div>
