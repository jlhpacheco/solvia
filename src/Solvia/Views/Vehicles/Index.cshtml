@model IReadOnlyList<Solvia.Models.Vehicle>
@{
    ViewData["Title"] = "My cars";
}

<h1 class="display-5 fw-bold">My cars</h1>

@if (Model.Count == 0)
{
    <p class="fs-3">No cars yet. Your car is saved when you get a permit.</p>
    <a class="btn btn-success btn-lg w-100 py-3 fs-3 mb-3" href="/Vehicles/Create">Add a car</a>
    <a class="btn btn-outline-primary btn-lg w-100 py-3 fs-3" href="/Permits/Apply">Get my parking permit</a>
}
else
{
    <div class="list-group">
        @foreach (var vehicle in Model)
        {
            <div class="list-group-item py-3">
                <p class="fs-2 fw-bold mb-1">@vehicle.Plate</p>
                <p class="fs-4 mb-2">@vehicle.Color @vehicle.Make @vehicle.Model — @vehicle.State</p>
                <a class="btn btn-outline-primary btn-lg fs-4" href="/Vehicles/Edit/@vehicle.Id">Fix it</a>
            </div>
        }
    </div>
    <a class="btn btn-success btn-lg w-100 py-3 fs-3 mt-3" href="/Vehicles/Create">Add a car</a>
}
