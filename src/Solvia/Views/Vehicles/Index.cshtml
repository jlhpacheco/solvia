@model Solvia.Models.ViewModels.VehicleIndexViewModel
@{
    ViewData["Title"] = "My vehicles";
}

<h1 class="mt-4">My vehicles</h1>
<p class="fs-5">
    @Model.StudentName's garage. Save a car here once — then a permit can point at it.
</p>

@if (Model.Vehicles.Count == 0)
{
    <div class="sv-card">
        <h2 class="fs-3">No vehicles yet</h2>
        <p class="fs-5 mb-0">
            Add your car first. A permit application picks from the cars saved here.
        </p>
        <a class="btn btn-primary sv-cta w-100 mt-3" asp-action="Create">Add a vehicle</a>
    </div>
}
else
{
    <div class="list-group">
        @foreach (var vehicle in Model.Vehicles)
        {
            <div class="roster-card p-3 d-flex flex-wrap align-items-center gap-3">
                <div class="me-auto">
                    <div class="fs-2 fw-bold">
                        @vehicle.Plate <span class="fs-4 text-muted">· @vehicle.State</span>
                    </div>
                    <div class="fs-5">
                        @(string.Join(" ", new[] { vehicle.Make, vehicle.Model }.Where(s => !string.IsNullOrWhiteSpace(s))))
                        <span class="text-muted">(@vehicle.Color)</span>
                    </div>
                </div>
                <a class="btn btn-outline-primary btn-lg" asp-action="Edit" asp-route-id="@vehicle.Id">Edit</a>
            </div>
        }
    </div>
    <a class="btn btn-primary sv-cta w-100 mt-3" asp-action="Create">Add a vehicle</a>
}
