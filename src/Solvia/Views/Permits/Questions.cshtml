@model Solvia.Models.ViewModels.QuestionsViewModel
@inject Microsoft.Extensions.Options.IOptions<Solvia.Config.AiOptions> AiSettings
@{
    ViewData["Title"] = "Three quick questions";
}

<h1 class="mt-4">Three quick questions</h1>
<p class="fs-5">That is all Solvia ever asks. No long form.</p>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <div class="alert alert-info fs-5" role="status">@Model.Notice</div>
}

<div class="sv-card mt-3">
    <p class="fs-4 mb-1"><strong>1 · Your college</strong></p>
    <p class="fs-4 mb-0">
        @Model.College
        <button class="btn btn-link fs-5 ms-2" type="submit" form="vehicle-questions"
                formaction="@Url.Action("ChooseCollege", "Permits")" formnovalidate>change</button>
    </p>
</div>

<div class="sv-card mt-3">
    <form asp-action="Understand" method="post" id="vehicle-questions" data-permit-draft="questions" data-flow-id="@Model.FlowId" data-draft-owner="@Model.DraftOwner">
        <input type="hidden" name="flowId" value="@Model.FlowId" />
        <input type="hidden" name="college" value="@Model.College" />
        @if (Model.StartDate is { } plannedStart)
        {
            <input type="hidden" name="startDate" value="@plannedStart.ToString("yyyy-MM-dd")" />
            <p class="alert alert-info">Planned start: <strong>@plannedStart.ToString("MMM d, yyyy")</strong>. This application is for one permit. <a href="/Planner">Change the plan</a></p>
        }
        @if (Model.ApplicationId is { } draftId)
        {
            <input type="hidden" name="applicationId" value="@draftId" />
        }

        <label class="form-label fs-4" for="carText"><strong>2 · Your car</strong> — say it in one sentence</label>
        <textarea class="form-control fs-4" id="carText" name="carText" rows="2" maxlength="@Solvia.Models.ViewModels.PermitDraftViewModel.MaxCarTextLength"
                  placeholder="Example: blue 2019 Honda Civic, plate 8XYZ123">@Model.CarText</textarea>
        <p class="fs-6 text-muted mt-2 mb-0">
            @if (AiSettings.Value.Provider.Equals("together", StringComparison.OrdinalIgnoreCase))
            {
                <text>Use a fictional vehicle. Solvia sends your vehicle sentence to Together's
                hosted AI reader, OpenAI's US-developed GPT-OSS 120B. Do not include personal information.</text>
            }
            else
            {
                <text>Use a fictional vehicle. Solvia sends your vehicle sentence to its
                configured Ollama AI reader.</text>
            }
            If the model is unavailable, plain rules read your answers and the next
            screen labels the fallback. You can edit every field before saving.
        </p>

        <p class="fs-4 mt-4 mb-2"><strong>3 · Your permit</strong></p>
        <partial name="_DailyPermitNotice" />
        @if (Model.College == "Modesto Junior College / Columbia College / YCCD")
        {
            <partial name="_MJCPolicyNote" />
        }
        <div class="d-flex flex-wrap gap-2" role="radiogroup" aria-label="Permit type">
            <input type="radio" class="btn-check" name="permitType" id="typeTerm" value="Term"
                   checked="@(Model.PermitType == Solvia.Models.Enums.PermitTypeCode.Term)" />
            <label class="btn btn-outline-primary btn-lg fs-4" for="typeTerm">Term permit — a whole semester</label>
            <input type="radio" class="btn-check" name="permitType" id="typeDaily" value="Daily"
                   checked="@(Model.PermitType == Solvia.Models.Enums.PermitTypeCode.Daily)" />
            <label class="btn btn-outline-primary btn-lg fs-4" for="typeDaily">Day pass — one day</label>
        </div>

        <div id="term-options" hidden="@(Model.PermitType == Solvia.Models.Enums.PermitTypeCode.Daily)">
            <div class="d-flex flex-wrap gap-2 mt-3" role="radiogroup" aria-label="Term">
                @foreach (var term in Enum.GetNames<Solvia.Models.Enums.TermKind>())
                {
                    <input type="radio" class="btn-check" name="term" id="term@(term)" value="@term"
                           checked="@(Model.Term.ToString() == term)" />
                    <label class="btn btn-outline-secondary btn-lg fs-4" for="term@(term)">@term</label>
                }
            </div>
        </div>

        <button type="submit" id="read-answers" class="btn btn-primary sv-cta w-100 mt-4">Read my answers</button>
        <div id="ai-reading-status" role="status" aria-live="polite" hidden>
            <p class="mt-3 mb-2">Reading your vehicle details… You'll review every field next.</p>
            <progress class="w-100" aria-label="Reading vehicle details"></progress>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/permit-draft.js" asp-append-version="true" defer></script>
    <script src="~/js/questions.js" asp-append-version="true" defer></script>
}
