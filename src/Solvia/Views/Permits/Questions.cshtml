@model Solvia.Models.ViewModels.QuestionsViewModel
@{
    ViewData["Title"] = "3 quick questions";
}

<h1 class="display-5 fw-bold">3 quick questions</h1>
<p class="fs-4">That is all we ask. No long form.</p>

@if (Model.Notice is not null)
{
    <div class="alert alert-warning fs-4" role="alert">@Model.Notice</div>
}

<form method="post" action="/Permits/Understand">
    @Html.AntiForgeryToken()
    <input type="hidden" name="college" value="@Model.College" />

    <div class="mb-4">
        <p class="fs-3 fw-bold mb-1">1. Your college</p>
        <p class="fs-3 mb-0">@Model.College</p>
        <a class="fs-5" href="/Permits/Apply">Change college</a>
    </div>

    <div class="mb-4">
        <label class="form-label fs-3 fw-bold" for="carText">2. Tell me about your car</label>
        <textarea id="carText" name="carText" rows="3" class="form-control fs-4"
                  placeholder="Blue 2019 Honda Civic, plate 8XYZ123">@Model.CarText</textarea>
        <p class="fs-5 text-muted mt-1">Color, make, model, and plate — in your own words.</p>
    </div>

    <div class="mb-4">
        <p class="fs-3 fw-bold mb-2">3. Your term</p>

        <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Permit type">
            <input type="radio" class="btn-check" name="permitType" id="ptTerm" value="Term"
                   @(Model.PermitType == Solvia.Models.Enums.PermitTypeCode.Term ? "checked" : "") />
            <label class="btn btn-outline-primary btn-lg fs-4 px-4 py-3" for="ptTerm">Term permit</label>

            <input type="radio" class="btn-check" name="permitType" id="ptDaily" value="Daily"
                   @(Model.PermitType == Solvia.Models.Enums.PermitTypeCode.Daily ? "checked" : "") />
            <label class="btn btn-outline-primary btn-lg fs-4 px-4 py-3" for="ptDaily">Day pass</label>
        </div>

        <div class="d-flex flex-wrap gap-2" role="group" aria-label="Term">
            <input type="radio" class="btn-check" name="term" id="termFall" value="Fall"
                   @(Model.Term == Solvia.Models.Enums.TermKind.Fall ? "checked" : "") />
            <label class="btn btn-outline-primary btn-lg fs-4 px-4 py-3" for="termFall">Fall</label>

            <input type="radio" class="btn-check" name="term" id="termSpring" value="Spring"
                   @(Model.Term == Solvia.Models.Enums.TermKind.Spring ? "checked" : "") />
            <label class="btn btn-outline-primary btn-lg fs-4 px-4 py-3" for="termSpring">Spring</label>

            <input type="radio" class="btn-check" name="term" id="termSummer" value="Summer"
                   @(Model.Term == Solvia.Models.Enums.TermKind.Summer ? "checked" : "") />
            <label class="btn btn-outline-primary btn-lg fs-4 px-4 py-3" for="termSummer">Summer</label>
        </div>
    </div>

    <button type="submit" class="btn btn-success btn-lg w-100 py-3 fs-3">Next</button>
</form>
