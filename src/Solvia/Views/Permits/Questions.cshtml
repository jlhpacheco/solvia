@model Solvia.Models.ViewModels.QuestionsViewModel
@{
    ViewData["Title"] = "Three quick questions";
}

<h1 class="mt-4">Three quick questions</h1>
<p class="fs-5">That is all Solvia ever asks. No long form.</p>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <div class="alert alert-info fs-5" role="status">@Model.Notice</div>
}

<div class="sv-card mt-3">
    <p class="fs-4 mb-1"><strong>1 · Your college</strong></p>
    <p class="fs-4 mb-0">
        @Model.College
        <a class="fs-5 ms-2" href="/Permits/Ask">change</a>
    </p>
</div>

<div class="sv-card mt-3">
    <form asp-action="Understand" method="post">
        <input type="hidden" name="college" value="@Model.College" />
        @if (Model.ApplicationId is { } draftId)
        {
            <input type="hidden" name="applicationId" value="@draftId" />
        }

        <label class="form-label fs-4" for="carText"><strong>2 · Your car</strong> — say it in one sentence</label>
        <textarea class="form-control fs-4" id="carText" name="carText" rows="2"
                  placeholder="Example: blue 2019 Honda Civic, plate 8XYZ123">@Model.CarText</textarea>
        <p class="fs-6 text-muted mt-2 mb-0">
            Solvia sends these demo details to its configured AI reader (Phi-4-mini
            via Ollama). Use a fictional vehicle. If the model is unavailable, plain
            rules read your answers and the next screen labels the fallback.
        </p>

        <p class="fs-4 mt-4 mb-2"><strong>3 · Your permit</strong></p>
        <div class="d-flex flex-wrap gap-2" role="radiogroup" aria-label="Permit type">
            <input type="radio" class="btn-check" name="permitType" id="typeTerm" value="Term"
                   checked="@(Model.PermitType == Solvia.Models.Enums.PermitTypeCode.Term)" />
            <label class="btn btn-outline-primary btn-lg fs-4" for="typeTerm">Term permit — a whole semester</label>
            <input type="radio" class="btn-check" name="permitType" id="typeDaily" value="Daily"
                   checked="@(Model.PermitType == Solvia.Models.Enums.PermitTypeCode.Daily)" />
            <label class="btn btn-outline-primary btn-lg fs-4" for="typeDaily">Day pass — one day</label>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3" role="radiogroup" aria-label="Term">
            @foreach (var term in Enum.GetNames<Solvia.Models.Enums.TermKind>())
            {
                <input type="radio" class="btn-check" name="term" id="term@(term)" value="@term"
                       checked="@(Model.Term.ToString() == term)" />
                <label class="btn btn-outline-secondary btn-lg fs-4" for="term@(term)">@term</label>
            }
        </div>

        <button type="submit" class="btn btn-primary sv-cta w-100 mt-4">Read my answers</button>
    </form>
</div>
