@model Solvia.Models.ViewModels.MyPermitsViewModel
@{
    ViewData["Title"] = "My permits";
}

<div class="d-flex flex-wrap align-items-center gap-3 mt-4">
    <h1 class="mb-0">My permits</h1>
    <a class="btn btn-primary sv-cta ms-md-auto" href="/Permits/Apply">Apply for a Permit</a>
</div>
<p class="fs-5 text-muted mt-2">Permits for @Model.StudentName — only yours are ever listed here.</p>

@* Summary tiles (item 37): total / Paid / pending payment,
   computed from this person's own rows only. *@
<div class="row g-3 mt-1">
    <div class="col-12 col-md-4">
        <div class="sv-card text-center h-100">
            <p class="display-5 fw-bold mb-0">@Model.TotalCount</p>
            <p class="fs-5 mb-0">Total permits</p>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="sv-card text-center h-100">
            <p class="display-5 fw-bold mb-0">@Model.PaidCount</p>
            <p class="fs-5 mb-0">Paid</p>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="sv-card text-center h-100">
            <p class="display-5 fw-bold mb-0">@Model.PendingPaymentCount</p>
            <p class="fs-5 mb-0">Pending payment</p>
        </div>
    </div>
</div>

@if (Model.Rows.Count == 0)
{
    @* Empty state (item 41). *@
    <div class="sv-card mt-4 text-center">
        <h2 class="fs-3">No applications yet</h2>
        <p class="fs-5">When you apply for a parking permit, it shows up here.</p>
        <a class="btn btn-primary sv-cta w-100" href="/Permits/Apply">Apply for a Permit</a>
    </div>
}
else
{
    @* Desktop table — Duvara's column set (item 38). *@
    <div class="sv-card mt-4 d-none d-xxl-block table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Submitted</th>
                    <th scope="col">Campus</th>
                    <th scope="col">Permit</th>
                    <th scope="col">Vehicle</th>
                    <th scope="col">Dates</th>
                    <th scope="col">Category</th>
                    <th scope="col">Payment</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.SubmittedDisplay</td>
                    <td>@row.Campus</td>
                    <td>@row.TypeName</td>
                    <td>@row.VehicleDisplay</td>
                    <td>@row.DatesDisplay</td>
                    <td>@row.CategoryLabel</td>
                    <td>@row.PaymentDisplay</td>
                    <td class="text-nowrap">
                        @if (row.ShowPayNow)
                        {
                            <a class="btn btn-primary btn-sm" href="/Checkout/@row.Id">Pay Now</a>
                        }
                        @if (row.ShowPdf)
                        {
                            <a class="btn btn-outline-primary btn-sm" href="/Permits/PermitPdf/@row.Id">Permit (PDF)</a>
                        }
                        <a class="btn btn-link btn-sm" href="/Permits/Receipt/@row.Id">Receipt</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @* Mobile cards (item 38): same facts, badge first. *@
    <div class="d-xxl-none">
    @foreach (var row in Model.Rows)
    {
        <div class="sv-card mt-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h2 class="fs-4 mb-0">@row.TypeName</h2>
                @if (row.IsLive)
                {
                    <span class="badge bg-success fs-6">Live</span>
                }
                else if (row.ShowPayNow)
                {
                    <span class="badge bg-warning text-dark fs-6">Payment due</span>
                }
                else
                {
                    <span class="badge bg-secondary fs-6">@row.PaymentDisplay</span>
                }
            </div>
            <dl class="fs-5 mb-0 mt-2">
                <dt>Submitted</dt>
                <dd>@row.SubmittedDisplay</dd>
                <dt>Campus</dt>
                <dd>@row.Campus</dd>
                <dt>Vehicle</dt>
                <dd>@row.VehicleDisplay</dd>
                <dt>Dates</dt>
                <dd>@row.DatesDisplay</dd>
                <dt>Category</dt>
                <dd>@row.CategoryLabel</dd>
                <dt>Payment</dt>
                <dd>@row.PaymentDisplay</dd>
                @if (row.ReceiptNumber is not null)
                {
                    <dt>Permit number</dt>
                    <dd>@row.ReceiptNumber</dd>
                }
            </dl>
            <div class="d-grid gap-2 mt-3">
                @if (row.ShowPayNow)
                {
                    <a class="btn btn-primary btn-lg py-3" href="/Checkout/@row.Id">Pay Now</a>
                }
                @if (row.ShowPdf)
                {
                    <a class="btn btn-outline-primary btn-lg py-3" href="/Permits/PermitPdf/@row.Id">Permit (PDF)</a>
                }
                <a class="btn btn-outline-secondary btn-lg py-3" href="/Permits/Receipt/@row.Id">Receipt</a>
            </div>
        </div>
    }
    </div>

    <p class="mt-4">
        <a class="btn btn-outline-primary btn-lg w-100 py-3" href="/Permits/Apply">Get another permit</a>
    </p>
}
