@model Solvia.Models.ViewModels.PermitDraftViewModel
@{
    ViewData["Title"] = "Did I get this right?";
    var stateNames = Enum.GetNames<Solvia.Models.Enums.UsState>();
    var colorNames = Enum.GetNames<Solvia.Models.Enums.VehicleColor>();
    var chosenState = string.IsNullOrWhiteSpace(Model.CarState) ? "CA" : Model.CarState;
    var chosenColor = !string.IsNullOrWhiteSpace(Model.CarColor) &&
                      Array.IndexOf(colorNames, Model.CarColor) >= 0
        ? Model.CarColor
        : "Other";
}

<h1 class="mt-4">Did I get this right?</h1>
<p class="fs-5 text-muted">@Model.SourceNote</p>
<p class="fs-5">
    The reading only <em>pre-fills</em> the boxes — fix anything by typing.
    What you leave here is what gets saved.
</p>

@if (Model.PlateMissing)
{
    <div class="alert alert-warning fs-4" role="alert">
        <strong>I still need your plate</strong> — type it in the box below.
        Nothing moves on until your permit has a plate.
    </div>
}

<div class="sv-card mt-3">
    <form asp-action="Review" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        @if (Model.ApplicationId is { } draftId)
        {
            <input type="hidden" name="ApplicationId" value="@draftId" />
        }
        <input type="hidden" name="College" value="@Model.College" />
        <input type="hidden" name="CarText" value="@Model.CarText" />
        <input type="hidden" name="PermitType" value="@Model.PermitType" />
        <input type="hidden" name="Term" value="@Model.Term" />
        <input type="hidden" name="Source" value="@Model.Source" />
        @if (Model.StartDate is { } plannedStart)
        {
            <input type="hidden" name="StartDate" value="@plannedStart.ToString("yyyy-MM-dd")" />
            <p>Planned start: <strong>@plannedStart.ToString("MMM d, yyyy")</strong> · one permit</p>
        }

        <p class="fs-4 mb-3">
            College: <strong>@Model.College</strong><br />
            Permit: <strong>@(Model.PermitType == Solvia.Models.Enums.PermitTypeCode.Daily ? "Day pass" : $"Term permit · {Model.Term}")</strong>
        </p>

        <div class="mb-3">
            <label class="form-label fs-4" for="plateInput">License plate</label>
            <input class="form-control form-control-lg fs-3" id="plateInput" name="Plate"
                   value="@Model.Plate" autocomplete="off" placeholder="Type your plate" required maxlength="14" aria-describedby="plate-help" />
            <div id="plate-help" class="form-text">Check this number carefully. Use 4–10 letters or digits; spaces and hyphens are removed.</div>
        </div>

        <div class="mb-3">
            <label class="form-label fs-4" for="CarState">Plate state</label>
            <select class="form-select form-select-lg" id="CarState" name="CarState">
                @foreach (var state in stateNames)
                {
                    <option value="@state" selected="@(chosenState == state)">@state</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label fs-4" for="CarMake">Make</label>
            <input class="form-control form-control-lg" id="CarMake" name="CarMake" value="@Model.CarMake" autocomplete="off" />
        </div>

        <div class="mb-3">
            <label class="form-label fs-4" for="CarModel">Model</label>
            <input class="form-control form-control-lg" id="CarModel" name="CarModel" value="@Model.CarModel" autocomplete="off" />
        </div>

        <div class="mb-3">
            <label class="form-label fs-4" for="CarColor">Color</label>
            <select class="form-select form-select-lg" id="CarColor" name="CarColor">
                @foreach (var color in colorNames)
                {
                    <option value="@color" selected="@(chosenColor == color)">@color</option>
                }
            </select>
        </div>

        <button type="submit" id="continueButton" class="btn btn-primary sv-cta w-100 mt-2">
            Yes — show my total
        </button>
        <button type="submit" class="btn btn-outline-secondary btn-lg w-100 mt-2 py-3"
                formaction="@Url.Action("Questions", "Permits")" formnovalidate>
            Fix it — back to the questions
        </button>
    </form>
</div>

@section Scripts {
    <script>
        // A nicety only — the server gate is the law: no plate, no advance.
        (function () {
            var plate = document.getElementById('plateInput');
            var button = document.getElementById('continueButton');
            if (!plate || !button) { return; }
            function sync() { button.disabled = plate.value.trim().length === 0; }
            plate.addEventListener('input', sync);
            sync();
        })();
    </script>
}
