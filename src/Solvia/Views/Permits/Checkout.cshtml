@model Solvia.Models.PermitApplication
@{
    var clientId = ViewData["PayPalClientId"] as string;
    var amount = ViewData["AmountDisplay"] as string;
    var error = ViewData["CheckoutError"] as string;
    var info = ViewData["CheckoutInfo"] as string;
    var isFree = Model.PriceCents <= 0;
    var isLive = Model.PaymentStatus == Solvia.Models.Enums.PaymentStatus.Paid
        || Model.PaymentStatus == Solvia.Models.Enums.PaymentStatus.NotRequired;
}

<h1>Checkout</h1>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (info is not null)
{
    <div class="alert alert-info" role="alert">@info</div>
}

<p>Permit: <strong>@(Model.PermitType?.Name ?? "Parking permit")</strong></p>
<p>Valid: @Model.StartDate to @Model.EndDate</p>
<p>
    Total: <strong>$@amount</strong>
    <span class="text-muted">(the exact fee from your college's published fee row)</span>
</p>

@if (isLive)
{
    <div class="alert alert-success" role="alert">
        This permit is already live — permit number <strong>@Model.ReceiptNumber</strong>.
    </div>
    <p><a href="/Checkout/Done/@Model.Id">See my permit</a></p>
}
else if (isFree)
{
    <p>
        Good news: this permit is <strong>free</strong> at your college —
        no payment is needed and PayPal is not involved.
    </p>
    <form method="post" action="/Checkout/Start/@Model.Id">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary">Confirm my free permit</button>
    </form>
}
else if (string.IsNullOrWhiteSpace(clientId))
{
    <div class="alert alert-warning" role="alert">
        PayPal is not configured on this machine yet. Add the sandbox
        credentials (PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET) and restart
        Solvia — checkout stays unavailable until then, and nothing is charged.
    </div>
}
else
{
    @* PayPal JS SDK buttons. The client id comes from config via
       ViewData — it is never hardcoded in this view. *@
    <div id="paypal-button-container"></div>

    <p class="mt-3">— or use the plain redirect instead —</p>
    <form method="post" action="/Checkout/Start/@Model.Id">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary">Pay $@amount with PayPal</button>
    </form>
    <p class="text-muted">Sandbox only — a test account, never real money.</p>

    <script src="https://www.paypal.com/sdk/js?client-id=@clientId&currency=USD&intent=capture"></script>
    <script>
        paypal.Buttons({
            createOrder: function () {
                return fetch('/api/paypal/create-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ permitApplicationId: '@Model.Id' })
                }).then(function (res) { return res.json(); })
                  .then(function (data) { return data.id; });
            },
            onApprove: function (data) {
                return fetch('/api/paypal/capture', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderId: data.orderID })
                }).then(function (res) { return res.json(); })
                  .then(function () { window.location = '/Checkout/Done/@Model.Id'; });
            }
        }).render('#paypal-button-container');
    </script>
}
