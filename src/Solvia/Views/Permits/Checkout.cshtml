@model Solvia.Models.PermitApplication
@{
    var currency = (ViewData["PayPalCurrency"] as string) ?? "USD";
    var error = ViewData["CheckoutError"] as string;
    var info = ViewData["CheckoutInfo"] as string;
    var amount = (Model.PriceCents / 100m).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    string Date(System.DateOnly d) => d.ToString("MMM d, yyyy");
}

<h1 class="mt-4">Checkout</h1>
@if (error is not null)
{
    <div class="alert alert-danger fs-5 mt-3" role="alert">@error</div>
}
@if (info is not null)
{
    <div class="alert alert-info fs-5 mt-3" role="alert">@info</div>
}

<div class="sv-card mt-3">
    <dl class="mb-0">
        <dt>College</dt><dd>@Model.Campus</dd>
        <dt>Category</dt><dd>@Model.Category</dd>
        <dt>Vehicle</dt>
        <dd>@Model.Vehicle?.Make @Model.Vehicle?.Model — plate @Model.Vehicle?.Plate · @Model.Vehicle?.State</dd>
        <dt>Permit</dt><dd>@(Model.PermitType?.Name ?? "Parking permit")</dd>
        <dt>Valid</dt><dd>@Date(Model.StartDate) → @Date(Model.EndDate)</dd>
    </dl>
    <div class="text-center mt-3">
        <p class="mb-1">Amount due</p>
        <p class="price-total mb-0">$@amount</p>
        <p class="text-muted mb-0">@currency · PayPal sandbox</p>
    </div>
</div>
@await Html.PartialAsync("_PayPalPaymentPanel", new Solvia.Models.ViewModels.PayPalPaymentPanelViewModel(
    Model.Id, Model.PriceCents, Solvia.Services.CheckoutReviewSnapshot.Compute(Model), Model.PayPalOrderId, Model.PayPalCaptureId))
