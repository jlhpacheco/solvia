@model Solvia.Models.ViewModels.ReceiptViewModel
@{
    ViewData["Title"] = "Your permit";
    string Date(System.DateOnly d) => d.ToString("MMM d, yyyy");
}

@if (Model.IsLive)
{
    @if (Model.IsActive)
    {
        <h1 class="display-4 fw-bold mt-4">Permit live &#10003;</h1>
    }
    else
    {
        <h1 class="display-4 fw-bold mt-4">@(Model.IsFree ? "Permit issued" : "Payment confirmed")</h1>
        <p class="alert alert-info">@Model.ValidityReason</p>
    }
    <p class="fw-semibold" data-testid="permit-validity-status">@Model.StatusDisplay</p>
    <a class="btn btn-primary btn-lg w-100 py-3 fs-3 mt-3" href="/Permits/PermitPdf/@Model.Id" aria-describedby="permit-download-help">Download permit (PDF)</a>
    <p id="permit-download-help" class="fs-6 text-muted mt-2 mb-3">
        Save the PDF, or print it on US Letter paper at Actual size (100%).
        For another copy, open <strong>My permits</strong>.
    </p>
}
else if (Model.CanPay)
{
    <h1 class="display-4 fw-bold mt-4">Not paid yet</h1>
    <p class="fs-4">This permit is not issued yet. Payment must complete before issuance; parking validity also depends on the printed dates.</p>
    <a class="btn btn-primary sv-cta w-100 mb-3" href="@Model.PaymentUrl">Finish paying</a>
}
else
{
    <h1 class="display-4 fw-bold mt-4">Permit status</h1>
    <p class="fs-4">This permit is not active and cannot accept a new payment.</p>
}

<div class="sv-card mt-3">
    <p class="fs-4 mb-1">Permit number</p>
    <p class="display-5 fw-bold">@(Model.ReceiptNumber ?? "—")</p>

    <dl class="fs-4 mb-0">
        <dt>College</dt>
        <dd>@Model.College</dd>

        <dt>Category</dt>
        <dd>@Model.CategoryLabel</dd>

        <dt>Car</dt>
        <dd>@Model.CarLine — plate @Model.PlateLine</dd>

        <dt>Permit</dt>
        <dd>@Model.TypeName</dd>

        <dt>Good for</dt>
        <dd>@Date(Model.StartDate) to @Date(Model.EndDate)</dd>

        <dt>@(Model.PurchaseId is null ? "Total" : "Daily permit fee for this date")</dt>
        <dd>@Model.TotalDisplay</dd>
        @if (Model.PurchaseId is { } purchaseId)
        {
            <dt>Prepaid purchase ID</dt>
            <dd class="text-break"><a href="/Prepaid/Review/@purchaseId"><code>@purchaseId</code></a></dd>
            <dt>Overall purchase total</dt>
            <dd>@Model.PurchaseTotalDisplay for @Model.PurchaseDayCount dates</dd>
        }
    </dl>

    @if (Model.PurchaseId is { } packetId)
    {
        <p class="mt-3">This receipt covers one dated permit in a prepaid purchase. The overall total applies to the whole purchase and is not charged again for each permit.</p>
        @if (Model.IsLive)
        {
            <a class="btn btn-outline-primary w-100" href="/Prepaid/Pdf/@packetId">Download all dated permits (PDF)</a>
        }
    }

    @if (Model.PayPalOrderId is not null || Model.PayPalCaptureId is not null)
    {
        <div class="mt-3">
            <p class="fs-5 fw-semibold mb-2">PayPal payment references (sandbox)</p>
            @if (Model.PayPalOrderId is not null)
            {
                <p class="mb-1">PayPal order ID<br /><code>@Model.PayPalOrderId</code></p>
            }
            @if (Model.PayPalCaptureId is not null)
            {
                <p class="mb-0">PayPal capture ID<br /><code>@Model.PayPalCaptureId</code></p>
            }
            else
            {
                <p class="mb-0">PayPal capture ID<br />Not issued yet — payment is not confirmed.</p>
            }
        </div>
    }
    @if (Model.IsFree)
    {
        <p class="fs-4 mt-3 mb-0">Issued without payment under the demo's free or exemption rules; actual campus eligibility may differ.</p>
    }

    @if (Model.VerifyUrl is not null)
    {
        <p class="fs-4 mt-4 mb-2">Anyone can check this permit:</p>
        <a class="btn btn-primary btn-lg w-100 py-3 fs-4" href="@Model.VerifyUrl">Check this permit</a>
        <p class="fs-6 text-muted text-break mt-2 mb-0">@Model.VerifyUrl</p>
    }
</div>

<a class="btn btn-outline-primary btn-lg w-100 py-3 fs-3 mt-4" href="/Permits/My">Back to my permits</a>
