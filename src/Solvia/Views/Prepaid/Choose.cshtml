@model Solvia.Models.ViewModels.PrepaidChooseViewModel
@using System.Globalization
@{ ViewData["Title"] = "Choose your prepaid dates"; }
@section Styles { <link rel="stylesheet" href="~/css/prepaid.css" asp-append-version="true" /> }
<div class="sv-prepaid">
    <p class="sv-eyebrow">1 · DATES &amp; VEHICLE &nbsp; 2 · REVIEW &amp; PAY &nbsp; 3 · YOUR PASSES</p>
    <h1>Choose your prepaid dates</h1>
    <p>@Model.Schedule.Campus · Pay once. Get a separate day pass for each selected date.</p>
    @if (Model.Error is not null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
    <form method="post" action="/Prepaid/Create" class="sv-card">
        @Html.AntiForgeryToken()
        <input type="hidden" name="plan" value="@Model.Plan" />
        <label for="prepaid-vehicle" class="form-label fw-bold">Vehicle</label>
        <select id="prepaid-vehicle" name="vehicleId" required class="form-select">
            <option value="">Choose your vehicle</option>
            @foreach (var vehicle in Model.Vehicles)
            { <option value="@vehicle.Id" selected="@(vehicle.Id == Model.VehicleId)">@vehicle.Label</option> }
        </select>
        <p class="mt-2"><a href="@Url.Action("Create", "Vehicles", new { returnUrl = Url.Action("Choose", "Prepaid", new { plan = Model.Plan }) })">Add a vehicle</a></p>
        <fieldset class="mt-4" aria-describedby="prepaid-date-help">
            <legend class="h4">Dates to buy</legend>
            <p id="prepaid-date-help">Uncheck any dates you do not need. Each pass is valid only on its printed date. Dates and vehicle are locked when payment starts.</p>
            <div class="sv-prepaid-dates" data-testid="prepaid-dates">
                @foreach (var date in Model.Schedule.Dates)
                {
                    var iso = date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
                    <label for="date-@iso"><input id="date-@iso" name="selectedDates" type="checkbox" value="@iso" checked="@Model.SelectedDates.Contains(date)" /> <time datetime="@iso">@date.ToString("ddd, MMM d, yyyy", CultureInfo.InvariantCulture)</time></label>
                }
            </div>
        </fieldset>
        <p class="mt-3"><strong>@(Model.UnitCents is { } unit ? "$" + (unit / 100m).ToString("0.00", CultureInfo.InvariantCulture) + " USD per date" : "Day-pass price not published")</strong>. Your exact total appears before payment. No payment is made on this page.</p>
        <button type="submit" class="btn btn-primary sv-cta">Review these dates</button>
        <a href="/Planner?showComparison=true" class="btn btn-outline-secondary">Revise my schedule</a>
    </form>
</div>
