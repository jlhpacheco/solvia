@model Solvia.Models.ViewModels.VerifyViewModel
@{
    ViewData["Title"] = "Permit check";
}

<div class="verify-card verify-invalid mt-4">
    <h1 class="display-1 fw-bold">NOT VALID</h1>
    <p class="fs-3">@Model.Reason</p>

    @if (Model.PermitNumber is not null || Model.Campus is not null)
    {
        <dl class="row fs-3 mt-4 text-start">
            @if (Model.PermitNumber is not null)
            {
                <dt class="col-sm-4">Permit number</dt>
                <dd class="col-sm-8"><strong>@Model.PermitNumber</strong></dd>
            }
            @if (Model.Campus is not null)
            {
                <dt class="col-sm-4">College</dt>
                <dd class="col-sm-8">@Model.Campus</dd>
            }
        </dl>
    }
</div>
