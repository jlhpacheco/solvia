@model Solvia.Models.ViewModels.CollegeSearchViewModel
@{
    ViewData["Title"] = "Find your college";
}

<h1 class="display-5 fw-bold">Find your college</h1>
<p class="lead">Type part of a college name — or a word from its fee notes, like “motorcycle”.</p>
<partial name="_DailyPermitNotice" />

<form method="get" asp-controller="College" asp-action="Search" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="college-q" class="form-label fs-5">College</label>
        <input id="college-q" name="q" value="@Model.Query" class="form-control form-control-lg" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-lg">Search</button>
    </div>
</form>

@* The honesty label: WHO served these results. If Elastic was
   configured but unreachable, the built-in match answered and this
   line says "builtin" — the page never claims otherwise. *@
<p class="fs-5 text-muted">
    Search served by: <strong>@Model.ServedBy</strong>
    @if (Model.ServedBy == Solvia.Services.ElasticCollegeSearch.ProviderName)
    {
        <span>— the local Elasticsearch colleges index.</span>
    }
    else
    {
        <span>— Solvia's built-in match over the fee catalog.</span>
    }
</p>

@if (Model.Rows.Count == 0)
{
    <p class="fs-4">No college matched. Try a shorter word — for example “Fresno”.</p>
}
else
{
    <ul class="list-group mb-4">
        @foreach (var row in Model.Rows)
        {
            <li class="list-group-item py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span class="fs-3 fw-bold">@row.Campus</span>
                    <span class="fs-4">Term permit: @row.SemesterPriceLabel</span>
                </div>
                @if (row.Campus == "Modesto Junior College / Columbia College / YCCD")
                {
                    <partial name="_MJCPolicyNote" />
                }
                <div class="fs-5 mt-1">
                    <a asp-controller="College" asp-action="Roster" asp-route-campus="@row.Campus">Who paid at @row.Campus</a> ·
                    <a asp-controller="College" asp-action="Dates" asp-route-campus="@row.Campus">Term dates</a>
                </div>
            </li>
        }
    </ul>
}
