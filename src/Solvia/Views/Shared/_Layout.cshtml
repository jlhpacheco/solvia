@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var workspace = controller is "Permits" or "MyPermits" or "Vehicles" or "College" or "Checkout";
    bool Active(string name, string? page = null) => controller == name && (page == null || action == page);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Solvia</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Solvia.styles.css" asp-append-version="true" />
</head>
<body class="@(workspace ? "sv-workspace" : "sv-public")">
    <a class="sv-skip-link" href="#main-content">Skip to content</a>
    <header class="sv-header">
        <div class="container sv-bar">
            <a asp-area="" asp-controller="Home" asp-action="Index" aria-label="Solvia home">
                <img class="sv-brand-icon" src="~/img/solvia-avatar.svg" asp-append-version="true" width="44" height="44" alt="" />
            </a>
            <div>
                <a class="sv-wordmark" asp-area="" asp-controller="Home" asp-action="Index">Solvia</a>
                <div class="sv-tagline">A clearer way to campus.</div>
            </div>
            <nav class="sv-nav" aria-label="Main">
                <a asp-area="" asp-controller="Permits" asp-action="Ask">Ask Solvia</a>
                <a asp-area="" asp-controller="Permits" asp-action="My">My permits</a>
                <a asp-area="" asp-controller="College" asp-action="Fees">College fees</a>
                <span class="sv-demo-badge">Sandbox demo</span>
            </nav>
        </div>
    </header>
    <div class="container sv-shell">
        @if (workspace)
        {
            <aside class="sv-sidebar">
                <span class="sv-sidebar-label">YOUR WORKSPACE</span>
                <nav aria-label="Permit workspace">
                    <a class="@(Active("Permits", "Ask") || Active("Permits", "Questions") ? "is-active" : "")" asp-controller="Permits" asp-action="Ask"><span aria-hidden="true">✧</span> Ask Solvia</a>
                    <a class="@(Active("Permits", "Apply") ? "is-active" : "")" asp-controller="Permits" asp-action="Apply"><span aria-hidden="true">＋</span> Apply for a permit</a>
                    <a class="@(Active("Permits", "My") || Active("MyPermits") ? "is-active" : "")" asp-controller="Permits" asp-action="My"><span aria-hidden="true">▤</span> My permits</a>
                    <a class="@(Active("Vehicles") ? "is-active" : "")" asp-controller="Vehicles" asp-action="Index"><span aria-hidden="true">▱</span> My vehicles</a>
                </nav>
                <span class="sv-sidebar-label">COLLEGE TOOLS</span>
                <nav aria-label="College tools">
                    <a class="@(Active("College", "Fees") ? "is-active" : "")" asp-controller="College" asp-action="Fees"><span aria-hidden="true">≡</span> Published fees</a>
                    <a class="@(Active("College", "Dates") ? "is-active" : "")" asp-controller="College" asp-action="Dates"><span aria-hidden="true">▦</span> Term dates</a>
                    <a class="@(Active("College", "Roster") ? "is-active" : "")" asp-controller="College" asp-action="Roster"><span aria-hidden="true">☷</span> College roster</a>
                </nav>
                <div class="sv-sidebar-note"><span class="sv-status-dot"></span> PayPal Sandbox<p>Fictional people.<br />Test payments only.</p></div>
            </aside>
        }
        <main id="main-content" class="sv-main pb-3" tabindex="-1">
            <partial name="_StatusBanner" />
            @RenderBody()
        </main>
    </div>

    <footer class="sv-footer">
        <div class="container">
            <span class="sv-foot-brand">Solvia</span> · Clear prices. Confident next steps.
            <span class="d-block mt-1">
                &copy; 2026 Solvia · Demo: fictional students, PayPal sandbox test money ·
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
