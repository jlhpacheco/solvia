<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Solvia</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Solvia.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sv-header">
        <div class="container sv-bar">
            <a asp-area="" asp-controller="Home" asp-action="Index" aria-label="Solvia home">
                <img class="sv-logo" src="~/img/logo.webp" alt="Solvia logo" />
            </a>
            <div>
                <a class="sv-wordmark" asp-area="" asp-controller="Home" asp-action="Index">SOLVIA</a>
                <div class="sv-tagline">College parking permits, paid with PayPal</div>
            </div>
            <nav class="sv-nav" aria-label="Main">
                <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a asp-area="" asp-controller="Permits" asp-action="My">My permits</a>
                <a asp-area="" asp-controller="College" asp-action="Fees">College fees</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </nav>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_StatusBanner" />
            @RenderBody()
        </main>
    </div>

    <footer class="sv-footer">
        <div class="container">
            <span class="sv-foot-brand">Solvia</span> — built with PayPal · San Jose
            <span class="d-block mt-1">
                &copy; 2026 Solvia · Demo: fictional students, PayPal sandbox test money ·
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
