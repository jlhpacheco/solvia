@using System.Text.Json
@model Solvia.Models.FeeTableViewModel

@*
    THE FEE-TABLE SEAM (§2e). Every fee table in Solvia renders
    through this partial and only this partial. Config
    FeeTable:Renderer picks the renderer; the rows (from IFeeCatalog,
    display strings computed on the server) are identical either way:

    - "aggrid": AG Grid Community edition (free, no license key, no
      trial) loaded from its official CDN; wwwroot/js/feetable.aggrid.js
      is the only AG Grid integration point in the app. If the CDN is
      unreachable, the adapter falls back to the native renderer below
      with the same rows.
    - "native": the plain server-rendered table in this file.
*@

@{
    var rowsJson = JsonSerializer.Serialize(Model.Rows,
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

<script type="application/json" id="fee-table-data">@Html.Raw(rowsJson)</script>
<div class="sv-fee-tools">
    <div>
        <label for="fee-search" class="form-label fw-bold">Find a campus or fee</label>
        <input id="fee-search" type="search" class="form-control" placeholder="Try Fresno or daily" aria-describedby="fee-search-help" />
        <div id="fee-search-help" class="form-text">Search across the table. Select a column heading to sort.</div>
    </div>
    <p id="fee-results" class="text-muted mb-0" role="status">@Model.Rows.Count campuses</p>
</div>

@if (string.Equals(Model.Renderer, "aggrid", StringComparison.OrdinalIgnoreCase))
{
    <div id="feeGrid" class="sv-fee-grid" aria-label="Published campus permit fees"></div>
    <p class="form-text mt-2">Interactive comparison powered by AG Grid Community. Published fees can change; confirm current terms with your campus.</p>
    <script src="~/js/feetable.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@34.3.1/dist/ag-grid-community.min.js"></script>
    <script src="~/js/feetable.aggrid.js" asp-append-version="true"></script>
}
else
{
    <table class="table table-striped fee-table" id="feeTableNative">
        <thead>
            <tr>
                <th scope="col">Campus</th>
                <th scope="col">Semester price</th>
                <th scope="col">Day-pass price</th>
                <th scope="col">Source note</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.Campus</td>
                    <td>@row.SemesterPrice</td>
                    <td>@row.DayPass</td>
                    <td>@row.SourceNote</td>
                </tr>
            }
        </tbody>
    </table>
    <script src="~/js/feetable.js" asp-append-version="true"></script>
    <script src="~/js/feetable.native.js" asp-append-version="true"></script>
}
