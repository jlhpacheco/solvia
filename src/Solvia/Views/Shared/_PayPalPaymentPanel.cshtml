@model Solvia.Models.ViewModels.PayPalPaymentPanelViewModel
@inject Microsoft.Extensions.Options.IOptions<Solvia.Config.PayPalOptions> PayPalSettings
@{
    // Only the public SDK client id/currency enter this markup. The server
    // secret remains in the payment service and never enters a view model.
    var clientId = PayPalSettings.Value.ClientId;
    var currency = string.IsNullOrWhiteSpace(PayPalSettings.Value.Currency) ? "USD" : PayPalSettings.Value.Currency;
    var amount = (Model.PriceCents / 100m).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    var sdkUrl = string.IsNullOrWhiteSpace(clientId) ? null
        : "https://www.paypal.com/sdk/js?client-id=" + Uri.EscapeDataString(clientId)
            + "&currency=" + Uri.EscapeDataString(currency) + "&intent=capture&enable-funding=card";
}

<section class="sv-card mt-3" id="checkout-payment" data-application-id="@Model.ApplicationId" data-reviewed-snapshot="@Model.ReviewedSnapshot" data-paypal-sdk-url="@sdkUrl" aria-labelledby="payment-options-heading">
    <h2 class="h4" id="payment-options-heading">Choose how to pay</h2>
    <p>Check your permit and total above. Payment is confirmed only after PayPal completes the capture.</p>
    <div id="checkout-feedback" class="alert alert-info mt-3" role="status" aria-live="polite" tabindex="-1" hidden></div>

    @if (sdkUrl is null)
    {
        <div class="alert alert-warning" role="alert">
            PayPal checkout is unavailable right now. Please try again later.
            Payment is not confirmed here. Check your permit status before retrying.
        </div>
    }
    else
    {
        @* PayPal supplies its own eligible funding options and branding.
           Loading/rendering these controls creates no order or capture. *@
        <div id="paypal-button-container"></div>
        <noscript>
            <p>Continue on PayPal to pay $@amount @currency.</p>
            <form method="post" action="/Checkout/Start/@Model.ApplicationId">
                @Html.AntiForgeryToken()
                <input type="hidden" name="reviewedSnapshot" value="@Model.ReviewedSnapshot" />
                <button type="submit" class="btn btn-outline-secondary">Continue to PayPal</button>
            </form>
        </noscript>
    }

    <div id="paypal-redirect-fallback" hidden>
        <p>Continue on PayPal to pay $@amount @currency.</p>
        <form method="post" action="/Checkout/Start/@Model.ApplicationId" id="plain-pay-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="reviewedSnapshot" value="@Model.ReviewedSnapshot" />
            <button type="submit" class="btn btn-outline-secondary">Continue to PayPal</button>
        </form>
    </div>

    <p class="text-muted mt-3 mb-0">Sandbox test payment — no real money. Use a <strong>Personal buyer</strong> test account, separate from the store's Business account.</p>
    <details class="mt-3">
        <summary>How do I make a test payment?</summary>
        <p class="mt-2 mb-2">Choose <strong>PayPal</strong> and sign in with a Personal Sandbox buyer account to use its test balance. Or choose <strong>Debit or Credit Card</strong> and use an official Sandbox test card on PayPal. Use test details only.</p>
        <a href="https://developer.paypal.com/credit-card-number-generator" target="_blank" rel="noopener noreferrer">Get PayPal's Sandbox test card details</a>
    </details>

    <details class="mt-3" id="payment-references">
        <summary>Payment status and references</summary>
        <p class="mt-2" id="payment-state">Payment not confirmed — this permit is not active.</p>
        <dl class="mb-0">
            <dt>PayPal order ID</dt>
            <dd id="paypal-order-id" class="text-break">@(Model.PayPalOrderId ?? "Not created yet — choose PayPal above.")</dd>
            <dt>PayPal capture ID</dt>
            <dd id="paypal-capture-id" class="text-break">@(Model.PayPalCaptureId ?? "Not issued yet — buyer approval and capture are required.")</dd>
        </dl>
        <p class="text-muted mt-2 mb-0">An order ID records a payment request. Only a completed capture confirms payment.</p>
    </details>
</section>
<script src="~/js/checkout.js" asp-append-version="true" defer></script>
