{
  // Committed on purpose: this file carries NO secrets — only paths,
  // defaults, and feature switches. The PayPal client id/secret are
  // supplied through environment variables or .NET user-secrets
  // (see appsettings.example.json and the repo-root .env.example).
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SolviaDb": "Data Source=solvia.db"
  },
  "PayPal": {
    "Environment": "sandbox",
    "BaseUrl": "https://api-m.sandbox.paypal.com"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "phi4-mini"
  },
  "FeesCsvPath": "data/fees.csv",
  "FeeTable": {
    "Renderer": "aggrid"
  },
  "Calendar": {
    "Renderer": "native"
  },
  "Search": {
    "Provider": "builtin"
  },
  "Elastic": {
    "Url": "http://localhost:9200",
    "Index": "colleges"
  },
  "Webhook": {
    // Payment-complete webhook (Zapier Catch Hook — see
    // docs/zapier-recipe.md). Empty = disabled, and that is the
    // default: nothing is sent anywhere until a URL is configured
    // here or via the WEBHOOK_URL environment variable.
    "Url": ""
  }
}
