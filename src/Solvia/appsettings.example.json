{
  // EXAMPLE ONLY — placeholder values, not real credentials.
  // Do not paste real secrets into any file you commit. For local runs,
  // prefer .NET user-secrets:
  //   dotnet user-secrets set "PayPal:ClientId" "<your sandbox client id>"
  //   dotnet user-secrets set "PayPal:ClientSecret" "<your sandbox secret>"
  // or the environment variables listed in the repo-root .env.example.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SolviaDb": "Data Source=solvia.db"
  },
  "PayPal": {
    "ClientId": "YOUR_PAYPAL_SANDBOX_CLIENT_ID",
    "ClientSecret": "YOUR_PAYPAL_SANDBOX_CLIENT_SECRET",
    "Environment": "sandbox",
    "BaseUrl": "https://api-m.sandbox.paypal.com",
    "Currency": "USD",
    "WebhookId": "YOUR_PAYPAL_WEBHOOK_ID_OR_EMPTY"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "phi4-mini",
    // Defaults to 10. Slower local runners can opt into up to 90 seconds.
    // Values outside 1–90 are clamped to that range.
    "TimeoutSeconds": 10
  },
  "AI": {
    "Provider": "ollama"
  },
  "Meta": {
    // Supply Meta:ApiKey via user-secrets or META_API_KEY, never this file.
    "Model": "muse-spark-1.3",
    "TimeoutSeconds": 10
  },
  "Category": {
    "EmployeeDomains": [ "college.example" ],
    "StudentDomains": [ "student.example" ]
  },
  "FeesCsvPath": "data/fees.csv",
  "FeeTable": {
    "Renderer": "aggrid"
  },
  "Calendar": {
    "Renderer": "native"
  },
  "Search": {
    "Provider": "builtin"
  },
  "Elastic": {
    "Url": "http://localhost:9200",
    "Index": "colleges"
  },
  "Webhook": {
    "Url": ""
  }
}
